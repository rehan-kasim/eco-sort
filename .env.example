# Copy to .env for local dev. NEVER commit .env.
# On Vercel: Project > Settings > Environment Variables > add the keys.
# Gemini is the one and only vision provider (gemini-3.6-flash).
GEMINI_API_KEY=paste-your-gemini-key-here
GEMINI_MODEL=gemini-3.6-flash
# Signs scan-match bonus tokens. Optional — falls back to GEMINI_API_KEY.
SCAN_TOKEN_SECRET=paste-a-long-random-string-here
# --- Firebase ---
# Database: connect Upstash Redis (Marketplace) or use the file DB locally.
# AI Logic: console.firebase.google.com/project/adminpanel-f2c20/ailogic > Get started.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_DB_URL=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MEASUREMENT_ID=
# --- Storage (optional — file DB used locally, Upstash on Vercel) ---
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Copy to .env for local dev. NEVER commit .env.
# On Vercel: Project → Settings → Environment Variables — add keys,
# then Storage → Marketplace → Upstash Redis (database, optional).
# Until Firebase AI Logic is enabled in your project, AI_PROVIDER=groq
# uses the Groq key below (verified working — qwen/qwen3.6-27b).

AI_PROVIDER=groq
GROQ_API_KEY=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
GROQ_MODEL=qwen/qwen3.6-27b

GEMINI_API_KEY=AIzaSyClFb1f4sHRG2_Qy2bvh10uZmuIMkAAV4I
GEMINI_MODEL=gemini-3.5-flash-lite

# Signs scan-match bonus tokens. Optional — falls back to GROQ_API_KEY.
# Set a dedicated random string in production for hygiene.
SCAN_TOKEN_SECRET=paste-a-long-random-string-here

# --- Database ---
# Vercel connects these automatically — leave empty locally (uses ./data/ecosort.json).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Firebase (skip AI for now — only database if you connect later) ---
# AI Logic NOT enabled — keep AI_PROVIDER=groq above.
# When you want Firebase: console.firebase.google.com/project/adminpanel-f2c20/ailogic → Get started,
# then uncomment these vars and switch AI_PROVIDER=firebase.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_DB_URL=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_SENDER_ID=
# VITE_FIREBASE_APP_ID=
